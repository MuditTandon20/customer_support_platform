DATABASE_URL=postgres://postgres:devpassword@localhost:5432/customer_support
JWT_SECRET=replace_with_at_least_32_random_characters
AI_COPILOT_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=replace_with_random_service_secret
API_BIND=0.0.0.0:8080
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ENABLE_SANDBOX=true
# Optional; leave unset to keep events in the durable local outbox/projection.
# KAFKA_BROKERS=localhost:9092
# Stage 1 public-testing profile. Keep real customer data out of this release.
BETA_MODE=false
MAX_ORGANIZATIONS=10
DB_MAX_CONNECTIONS=4
BACKGROUND_PROCESSING=false
# Kafka requires cargo build --features kafka; not used in the free profile.
