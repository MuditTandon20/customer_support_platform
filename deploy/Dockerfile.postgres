# Preserve PostgreSQL 17 and its data format. Only refresh the privilege helper.
# Digests are the upstream 1.20 release asset SHA-256 values, verified at build.
ARG TARGETARCH
FROM scratch AS gosu-amd64
ADD --checksum=sha256:b1892636c281590f34bc63c1118f058cd9de66c4ea463772e3909672d8b302ac --chmod=0755 https://github.com/tianon/gosu/releases/download/1.20/gosu-amd64 /gosu
FROM scratch AS gosu-arm64
ADD --checksum=sha256:c216cb762520edb5ab0acb21cb9bc4bcc5f1544d365e8952a21514f04ea233ee --chmod=0755 https://github.com/tianon/gosu/releases/download/1.20/gosu-arm64 /gosu
FROM gosu-${TARGETARCH} AS helper
FROM postgres:17-trixie
COPY --from=helper /gosu /usr/local/bin/gosu
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +
