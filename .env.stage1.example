# Future hosting configuration only. No resources are created by this file.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
JWT_SECRET=generate_at_least_32_random_characters
AI_SERVICE_TOKEN=generate_a_separate_random_service_secret
FRONTEND_ORIGIN=https://YOUR-ASTER-SITE.vercel.app
COOKIE_SECURE=true
BETA_MODE=true
MAX_ORGANIZATIONS=10
DB_MAX_CONNECTIONS=4
BACKGROUND_PROCESSING=false
ENABLE_SANDBOX=false
LLM_ENABLED=false
# Next.js server setting, never a NEXT_PUBLIC variable:
API_PROXY_URL=https://YOUR-ASTER-BACKEND.onrender.com
